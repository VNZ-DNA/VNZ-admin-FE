{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["../src/*"]
    },
    "types": ["node", "vite/client"],
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["components/**/*.ts", "components/**/*.tsx", "features/**/*.ts", "features/**/*.tsx", "contracts/**/*.ts", "vitest.config.ts"]
}
